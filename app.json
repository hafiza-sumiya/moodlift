{
  "expo": {
    "name": "MoodLift",
    "slug": "moodlift",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#8E48BB",
      "resizeMode": "contain"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.moodlift.app",
      "runtimeVersion": "1.0.0"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#8E48BB"
      },
      "package": "com.moodlift.app",
      "permissions": [
        "NOTIFICATIONS"
      ],
      "runtimeVersion": "1.0.0"
    },
    "web": {},
    "plugins": [
      [
        "expo-notifications",
        {
          "color": "#ffffff"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "864e6a3e-e32a-4569-8e56-909cd89e6dfa"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/864e6a3e-e32a-4569-8e56-909cd89e6dfa"
    }
  }
}